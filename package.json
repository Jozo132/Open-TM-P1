{
  "name": "open-tm-p1",
  "version": "1.0.0",
  "private": true,
  "description": "Open-TM-P1 Thermal Camera Android App",
  "scripts": {
    "build": "cd android && gradlew.bat assembleDebug",
    "deploy": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb\" install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "deploy:ota": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb\" connect %npm_config_device% && \"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb\" -s %npm_config_device% install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "start": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb\" shell am start -n com.github.opentmp1/.MainActivity"
  },
  "config": {
    "device": "192.168.1.100:5555"
  }
}
