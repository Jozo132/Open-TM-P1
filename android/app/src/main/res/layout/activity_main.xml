<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Thermal camera view fills the screen -->
    <com.github.opentmp1.ui.ThermalView
        android:id="@+id/thermalView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Status message shown when not streaming -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/overlay_bg"
        android:padding="12dp"
        android:textColor="@color/temp_text"
        android:textSize="16sp"
        android:text="@string/camera_not_found"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Temperature info bar (top-left) -->
    <LinearLayout
        android:id="@+id/tempInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/overlay_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/center_temp"
            android:textColor="@color/temp_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/min_temp"
            android:textColor="#FF44AAFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/max_temp"
            android:textColor="#FFFF4444"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTouch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/touch_temp"
            android:textColor="#FFFFDD00"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Control toolbar (bottom, always visible) -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/overlay_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnShutter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/btn_shutter"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnGain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1.5"
            android:text="@string/btn_gain"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnColormap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1.5"
            android:text="@string/btn_colormap"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnScreenshot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1.5"
            android:text="@string/btn_screenshot"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
