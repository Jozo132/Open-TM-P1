<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer white ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="#FFFFFFFF" />
            <size
                android:width="72dp"
                android:height="72dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner red rounded rectangle (stop icon) -->
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF3333" />
            <corners android:radius="6dp" />
            <size
                android:width="20dp"
                android:height="20dp" />
        </shape>
    </item>
</layer-list>
